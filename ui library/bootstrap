local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local TextService = game:GetService("TextService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local BASE_W, BASE_H = 720, 440
local BLEED = 18
local SIDEBAR_W = 156
local TOPBAR_H = 36
local HEADER_H = 46
local STATUS_H = 26
local PAD = 12

local THEME = {
	Accent     = Color3.fromRGB(139, 108, 239),
	Danger     = Color3.fromRGB(223, 94, 110),
	Success    = Color3.fromRGB(126, 206, 150),
	Panel      = Color3.fromRGB(31, 31, 33),
	PanelTop   = Color3.fromRGB(38, 38, 41),
	Section    = Color3.fromRGB(26, 26, 28),
	Field      = Color3.fromRGB(23, 23, 26),
	Track      = Color3.fromRGB(20, 20, 22),
	Stroke     = Color3.fromRGB(42, 42, 46),
	StrokeSoft = Color3.fromRGB(58, 58, 62),
	Text       = Color3.fromRGB(219, 219, 222),
	Muted      = Color3.fromRGB(155, 155, 163),
	Faint      = Color3.fromRGB(118, 118, 126),
	OnAccent   = Color3.fromRGB(246, 244, 255),
	Knob       = Color3.fromRGB(106, 106, 114),
	Font       = Enum.Font.Code,
}

local T_FAST  = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local T_MED   = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local T_OPEN  = TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local T_CLOSE = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
local T_POP   = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true)

local function new(class, props, children)
	local inst = Instance.new(class)
	local parent = props.Parent
	props.Parent = nil
	for k, v in pairs(props) do
		inst[k] = v
	end
	if children then
		for i = 1, #children do
			children[i].Parent = inst
		end
	end
	if parent then inst.Parent = parent end
	return inst
end

local function tween(obj, info, props)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

local function corner(r)
	return new("UICorner", { CornerRadius = UDim.new(0, r) })
end

local function round()
	return new("UICorner", { CornerRadius = UDim.new(1, 0) })
end

local function guiParent()
	local ok, hui = pcall(function() return gethui() end)
	if ok and typeof(hui) == "Instance" then return hui end
	local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
	if ok2 and cg then return cg end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function textWidth(text, size, font)
	local ok, v = pcall(function()
		return TextService:GetTextSize(text, size, font, Vector2.new(4000, 100)).X
	end)
	if ok then return v end
	return #text * size * 0.6
end

local Icons = {}

local function bar(parent, x, y, w, h, color, rot, rad)
	return new("Frame", {
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromOffset(w, h),
		Rotation = rot or 0,
		BackgroundColor3 = color,
		BorderSizePixel = 0,
	}, { new("UICorner", { CornerRadius = UDim.new(0, rad or 1) }) })
end

local function ring(parent, x, y, d, color, thickness)
	local f = new("Frame", {
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromOffset(d, d),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, { round() })
	local s = new("UIStroke", { Parent = f, Thickness = thickness or 1.4, Color = color })
	return f, s
end

local function dot(parent, x, y, d, color)
	return new("Frame", {
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromOffset(d, d),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
	}, { round() })
end

function Icons.crosshair(p, c, reg)
	local _, s = ring(p, 0.5, 0.5, 11, c)
	reg(s, "Color")
	reg(bar(p, 0.5, 0.06, 1.6, 4, c), "BackgroundColor3")
	reg(bar(p, 0.5, 0.94, 1.6, 4, c), "BackgroundColor3")
	reg(bar(p, 0.06, 0.5, 4, 1.6, c), "BackgroundColor3")
	reg(bar(p, 0.94, 0.5, 4, 1.6, c), "BackgroundColor3")
end

