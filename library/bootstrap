	local function fade(parent, props, rotation, from, to)
		local base = {
			Parent = parent,
			BackgroundColor3 = props.Color,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 4,
		}
		for k, val in pairs(props) do
			if k ~= "Color" then
				base[k] = val
			end
		end
		local f = create("Frame", base)
		corner(f, RADIUS)
		create("UIGradient", {
			Parent = f,
			Rotation = rotation,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, from),
				NumberSequenceKeypoint.new(1, to),
			}),
		})
		return f
	end

	self.sideFadeTop = fade(sidebar, {
		Color = C.Panel,
		Size = UDim2.new(1, -1, 0, 22),
	}, 90, 0, 1)
	self.sideFadeBottom = fade(sidebar, {
		Color = C.Panel,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, -1, 0, 28),
	}, 90, 1, 0)

	local topbar = create("Frame", {
		Parent = shell,
		Name = "Topbar",
		Position = UDim2.fromOffset(0, HEADER_H),
		Size = UDim2.new(1, 0, 0, TOPBAR_H),
		BackgroundColor3 = C.Header,
