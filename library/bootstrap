	})

	self.topList = create("Frame", {
		Parent = self.topScroll,
		Size = UDim2.new(0, 0, 1, 0),
		AutomaticSize = AUTO_X,
		BackgroundTransparency = 1,
		ZIndex = 2,
	})
	hlist(self.topList, TAB_GAP)

	self.topIndicator = self:_accent(create("Frame", {
		Parent = self.topScroll,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, 0),
		Size = UDim2.new(0, 40, 0, 2),
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 3,
	}, { create("UICorner", { CornerRadius = UDim.new(0, 1) }) }), "BackgroundColor3")

	local function edgeButton(isRight)
		local b = create("TextButton", {
			Parent = topbar,
			AnchorPoint = Vector2.new(isRight and 1 or 0, 0),
			Position = UDim2.fromScale(isRight and 1 or 0, 0),
			Size = UDim2.new(0, 46, 1, -1),
			BackgroundColor3 = C.Header,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			Text = "",
			Visible = false,
			ZIndex = 5,
		})
		create("UIGradient", {
			Parent = b,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, isRight and 1 or 0),
				NumberSequenceKeypoint.new(0.55, 0),
				NumberSequenceKeypoint.new(1, isRight and 0 or 1),
			}),
		})
		local cx = isRight and -14 or 14
		for i = 1, 2 do
			local upper = i == 1
			create("Frame", {
				Parent = b,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(isRight and 1 or 0, cx, 0.5, upper and -2 or 2),
				Size = UDim2.fromOffset(6, 2),
				Rotation = (upper == isRight) and 45 or -45,
				BackgroundColor3 = C.Muted,
				BorderSizePixel = 0,
				ZIndex = 6,
			}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		end
		self:_track(b.Activated:Connect(function()
			local sc = self.topScroll
			local s = self:_s()
			local maxX = math.max(0, (sc.AbsoluteCanvasSize.X - sc.AbsoluteWindowSize.X) / s)
			local step = (sc.AbsoluteWindowSize.X / s) * 0.6
			local nx = math.clamp(sc.CanvasPosition.X + (isRight and step or -step), 0, maxX)
			tween(sc, TI.Slide, { CanvasPosition = Vector2.new(nx, 0) })
		end))
		return b
	end
	self.topFadeLeft = edgeButton(false)
	self.topFadeRight = edgeButton(true)

	self.content = create("Frame", {
		Parent = shell,
		Name = "Content",
		Position = UDim2.fromOffset(SIDEBAR_W, HEADER_H),
		Size = UDim2.new(1, -SIDEBAR_W, 1, -(HEADER_H + STATUS_H)),
		BackgroundTransparency = 1,
	})

	local statusBar = create("Frame", {
		Parent = shell,
		Name = "Status",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, STATUS_H),
		BackgroundColor3 = C.Status,
		BorderSizePixel = 0,
	})
	self.statusBar = statusBar
	corner(statusBar, RADIUS)
	create("Frame", {
		Parent = statusBar,
		Size = UDim2.new(1, 0, 0, RADIUS),
		BackgroundColor3 = C.Status,
		BorderSizePixel = 0,
	})
	hline(statusBar)
	text({
		Parent = statusBar,
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(0.5, -14, 1, 0),
		Text = opts.Footer or "",
		TextColor3 = C.Muted,
		TextSize = 11,
	})
	self.statusRight = text({
		Parent = statusBar,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 0),
		Size = UDim2.new(0.5, -14, 1, 0),
		TextColor3 = C.Muted,
		TextSize = 11,
		TextXAlignment = RIGHT,
	})
	self:_updateStatus()

	self:_hook(function()
		self.sideIndicator.BackgroundColor3 = self:_soft()
		if self.ActiveTab then
			self.ActiveTab.icon.ImageColor3 = self.Accent
		end
	end)

	self:_track(closeBtn.MouseEnter:Connect(function()
		tween(closeBtn, TI.Hover, { BackgroundTransparency = 0 })
		tween(closeStroke, TI.Hover, { Color = C.Danger, Transparency = 0.1 })
		for i = 1, 2 do
			tween(closeBars[i], TI.Hover, { BackgroundColor3 = C.Danger })
		end
	end))
	self:_track(closeBtn.MouseLeave:Connect(function()
		tween(closeBtn, TI.Hover, { BackgroundTransparency = 1 })
		tween(closeStroke, TI.Hover, { Color = C.Border, Transparency = 0.4 })
		for i = 1, 2 do
			tween(closeBars[i], TI.Hover, { BackgroundColor3 = C.Muted })
		end
	end))
	self:_track(closeBtn.Activated:Connect(function()
		closeScale.Scale = 1
		tween(closeScale, TI.Press, { Scale = 0.88 })
		self:Toggle(false)
	end))

	self:_track(header.InputBegan:Connect(function(input)
		if not isPress(input) then
			return
		end
		self:_closePopup()
		local start = input.Position
		local base = root.Position
		self:_beginDrag(function(pos)
			local d = pos - start
			root.Position = UDim2.new(0.5, base.X.Offset + d.X, 0.5, base.Y.Offset + d.Y)
			self:_clamp()
		end)
	end))

	local function refreshFades()
		self:_updateFades()
	end
	self:_track(self.sideScroll:GetPropertyChangedSignal("CanvasPosition"):Connect(refreshFades))
	self:_track(self.sideScroll:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(refreshFades))
	self:_track(self.topScroll:GetPropertyChangedSignal("CanvasPosition"):Connect(refreshFades))
	self:_track(self.topScroll:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(refreshFades))

	self:_track(UserInputService.InputBegan:Connect(function(input, processed)
		if self.destroyed then
			return
		end
		if self._popup and isPress(input) then
			local p = input.Position
			if not inside(self._popup, p) and not inside(self._popupOwner, p) then
				self:_closePopup()
			end
		end
		if Library._listener then
			if input.UserInputType == Enum.UserInputType.Keyboard or isPress(input) then
				local listener = Library._listener
				Library._listener = nil
				Library._consumed = input
				listener(input)
			end
			return
		end
		if Library._consumed == input then
			return
		end
		if processed or input.UserInputType ~= Enum.UserInputType.Keyboard then
			return
		end
		local key = input.KeyCode
		if self.MenuKey and key == self.MenuKey then
			self:Toggle()
		end
		for i = 1, #self._binds do
			local kb = self._binds[i]
			if kb.Value == key and kb.Callback then
				if kb.Mode == "Hold" then
					task.spawn(kb.Callback, true)
				else
					task.spawn(kb.Callback)
				end
			end
		end
	end))

	self:_track(UserInputService.InputChanged:Connect(function(input)
		local d = self._drag
		if d and isMove(input) then
			d.move(input.Position)
		end
	end))

	self:_track(UserInputService.InputEnded:Connect(function(input)
		local d = self._drag
		if d and isPress(input) then
			self._drag = nil
			if d.stop then
				d.stop()
			end
		end
		if input.UserInputType == Enum.UserInputType.Keyboard then
			for i = 1, #self._binds do
				local kb = self._binds[i]
				if kb.Mode == "Hold" and kb.Value == input.KeyCode and kb.Callback then
					task.spawn(kb.Callback, false)
				end
			end
		end
	end))

	local vpConn
	local function hookCamera()
		if vpConn then
			vpConn:Disconnect()
			vpConn = nil
		end
		local cam = Workspace.CurrentCamera
		if not cam then
			return
		end
		vpConn = self:_track(cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			self:_fit()
		end))
		self:_fit()
	end
	self:_track(Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera))

	if UserInputService.TouchEnabled then
		local inset = GuiService:GetGuiInset()
		local mb = create("TextButton", {
			Parent = gui,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, inset.Y + 8),
			Size = UDim2.fromOffset(84, 32),
			BackgroundColor3 = C.Panel,
			AutoButtonColor = false,
			BorderSizePixel = 0,
			Font = FONT,
			Text = "Menu",
			TextColor3 = C.Text,
			TextSize = 13,
			ZIndex = 30,
		})
		corner(mb, 8)
		self:_accent(stroke(mb, C.Border), "Color")
		local moved = false
		self:_track(mb.InputBegan:Connect(function(input)
			if not isPress(input) then
				return
			end
			moved = false
			local start = input.Position
			local base = mb.Position
			self:_beginDrag(function(pos)
				local d = pos - start
				if not moved and math.abs(d.X) + math.abs(d.Y) < 8 then
					return
				end
				moved = true
				mb.Position = UDim2.new(base.X.Scale, base.X.Offset + d.X, base.Y.Scale, base.Y.Offset + d.Y)
			end)
		end))
		self:_track(mb.Activated:Connect(function()
			if moved then
				moved = false
				return
			end
			self:Toggle()
		end))
		self.mobileButton = mb
	end

	hookCamera()
	if self.W == 0 then
		self.W, self.H, self.S = BASE_W, BASE_H, 1
		self:_applyLayout()
	end

	gui.Parent = guiParent()
	Library.Windows[#Library.Windows + 1] = self
	self:Toggle(true)
	return self
end

function Library:Notify(opts)
	local w = Library.Windows[#Library.Windows]
	if w then
		w:Notify(opts)
	end
end

function Library:Destroy()
	for i = #Library.Windows, 1, -1 do
		Library.Windows[i]:Destroy()
	end
end

return Library
