		Visible = false,
	})
	self.topbar = topbar
	hline(topbar, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), ZIndex = 3 })

	self.topScroll = create("ScrollingFrame", {
		Parent = topbar,
		Position = UDim2.fromOffset(8, 0),
