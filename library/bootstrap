local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local TextService = game:GetService("TextService")
local HttpService = game:GetService("HttpService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local BASE_W, BASE_H = 720, 440
local MIN_W, MIN_H = 440, 300
local HEADER_H, TOPBAR_H, STATUS_H = 46, 38, 26
local SIDEBAR_W = 160
local TAB_H, TAB_GAP = 32, 2
local PAD, GAP = 12, 12
local MIN_COL = 210
local BLEED = 24
local RADIUS = 10
local ICON_URL = "https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/refs/heads/main/icons.lua"

local C = {
	Accent     = Color3.fromRGB(139, 108, 239),
	Panel      = Color3.fromRGB(31, 31, 33),
	Header     = Color3.fromRGB(38, 38, 41),
	Status     = Color3.fromRGB(27, 27, 29),
	Section    = Color3.fromRGB(26, 26, 28),
	Field      = Color3.fromRGB(22, 22, 25),
	FieldHover = Color3.fromRGB(33, 33, 37),
	Track      = Color3.fromRGB(17, 17, 19),
	Off        = Color3.fromRGB(48, 48, 54),
	Line       = Color3.fromRGB(42, 42, 46),
	Border     = Color3.fromRGB(58, 58, 62),
	Text       = Color3.fromRGB(222, 222, 226),
	Muted      = Color3.fromRGB(155, 155, 163),
	Faint      = Color3.fromRGB(118, 118, 126),
	OnAccent   = Color3.fromRGB(248, 246, 255),
	Knob       = Color3.fromRGB(122, 122, 130),
	Danger     = Color3.fromRGB(223, 94, 110),
}

local FONT = Enum.Font.Code
local LEFT, RIGHT = Enum.TextXAlignment.Left, Enum.TextXAlignment.Right
local AUTO_X, AUTO_Y = Enum.AutomaticSize.X, Enum.AutomaticSize.Y
local TRUNC, NOTRUNC = Enum.TextTruncate.AtEnd, Enum.TextTruncate.None

local QUAD, QUINT = Enum.EasingStyle.Quad, Enum.EasingStyle.Quint
local OUT, IN = Enum.EasingDirection.Out, Enum.EasingDirection.In

local TI = {
	Hover  = TweenInfo.new(0.14, QUAD, OUT),
	Snap   = TweenInfo.new(0.22, QUINT, OUT),
	Slide  = TweenInfo.new(0.32, QUINT, OUT),
	Open   = TweenInfo.new(0.34, QUINT, OUT),
	Close  = TweenInfo.new(0.18, QUAD, IN),
	Press  = TweenInfo.new(0.07, QUAD, OUT, 0, true),
	Reveal = TweenInfo.new(0.2, QUINT, OUT),
}

local function create(class, props, children)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	if children then
		for i = 1, #children do
			children[i].Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function tween(obj, info, props)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

local function corner(parent, r)
	return create("UICorner", { Parent = parent, CornerRadius = UDim.new(0, r) })
end

local function round(parent)
	return create("UICorner", { Parent = parent, CornerRadius = UDim.new(1, 0) })
end

local function stroke(parent, color, thickness, transparency)
	return create("UIStroke", {
		Parent = parent,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
	})
end

local function padding(parent, t, b, l, r)
	return create("UIPadding", {
		Parent = parent,
		PaddingTop = UDim.new(0, t),
		PaddingBottom = UDim.new(0, b),
		PaddingLeft = UDim.new(0, l),
		PaddingRight = UDim.new(0, r),
	})
end

local function vlist(parent, gap)
	return create("UIListLayout", {
		Parent = parent,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, gap or 0),
	})
end

local function hlist(parent, gap)
	return create("UIListLayout", {
		Parent = parent,
		SortOrder = Enum.SortOrder.LayoutOrder,
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, gap or 0),
	})
end

local function text(props)
	local base = {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Font = FONT,
		TextColor3 = C.Text,
		TextSize = 13,
		TextXAlignment = LEFT,
		TextTruncate = TRUNC,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return create("TextLabel", base)
end

local function hline(parent, props)
	local base = {
		Parent = parent,
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = C.Line,
		BorderSizePixel = 0,
	}
	for k, v in pairs(props or {}) do
		base[k] = v
	end
	return create("Frame", base)
end

local function isPress(input)
	local t = input.UserInputType
	return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
end

local function isMove(input)
	local t = input.UserInputType
	return t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch
end

local function inside(gui, pos)
	if not gui or not gui.Parent then
		return false
	end
	local a, s = gui.AbsolutePosition, gui.AbsoluteSize
	return pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
end

local function textWidth(str, size)
	local ok, v = pcall(function()
		return TextService:GetTextSize(str, size, FONT, Vector2.new(10000, 200)).X
	end)
	return ok and v or #str * size * 0.6
end

local function textHeight(str, size, width)
	local ok, v = pcall(function()
		return TextService:GetTextSize(str, size, FONT, Vector2.new(width, 10000)).Y
	end)
	return ok and v or size + 2
end

local function guiParent()
	local ok, hui = pcall(function()
		return gethui()
	end)
	if ok and typeof(hui) == "Instance" then
		return hui
	end
	local ok2, core = pcall(function()
		return game:GetService("CoreGui")
	end)
	if ok2 and core then
		local test = Instance.new("Folder")
		local can = pcall(function()
			test.Parent = core
		end)
		test:Destroy()
		if can then
			return core
		end
	end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local IconSet
local iconQueue = {}

task.spawn(function()
	local ok, result = pcall(function()
		return loadstring(game:HttpGet(ICON_URL))()
	end)
	if ok and type(result) == "table" and type(result["48px"]) == "table" then
		IconSet = result["48px"]
	else
		IconSet = false
	end
	local queue = iconQueue
	iconQueue = nil
	for i = 1, #queue do
		pcall(queue[i])
	end
end)

local function applyIcon(img, icon)
	if icon == nil or icon == "" or icon == false then
		img.Visible = false
		return false
	end
	if type(icon) == "number" or (type(icon) == "string" and icon:match("^%d+$")) then
		img.Image = "rbxassetid://" .. tostring(icon)
		return true
	end
	if type(icon) == "string" and icon:match("^rbxasset") then
		img.Image = icon
		return true
	end
	local function set()
		local entry = IconSet and IconSet[icon]
		if entry then
			img.Image = "rbxassetid://" .. tostring(entry[1])
			img.ImageRectSize = Vector2.new(entry[2][1], entry[2][2])
			img.ImageRectOffset = Vector2.new(entry[3][1], entry[3][2])
		end
	end
	if iconQueue then
		iconQueue[#iconQueue + 1] = set
	else
		set()
	end
	return true
end

local function canFiles()
	return typeof(writefile) == "function"
		and typeof(readfile) == "function"
		and typeof(isfile) == "function"
end

local Library = {
	Flags = {},
	Windows = {},
	Theme = C,
}

local Window = {}
Window.__index = Window

local Tab = {}
Tab.__index = Tab

local Section = {}
Section.__index = Section

local function setFlag(flag, value)
	if flag then
		Library.Flags[flag] = value
	end
end

function Window:_track(conn)
	self._conns[#self._conns + 1] = conn
	return conn
end

function Window:_accent(inst, prop)
	inst[prop] = self.Accent
	self._accentProps[#self._accentProps + 1] = { inst, prop }
	return inst
end

function Window:_hook(fn)
	self._accentHooks[#self._accentHooks + 1] = fn
end

function Window:_soft()
	return self.Accent:Lerp(C.Panel, 0.76)
end

function Window:_s()
	local o = self.root.Size.X.Offset
	if o <= 0 then
		return 1
	end
	local s = self.root.AbsoluteSize.X / o
	return s > 0 and s or 1
end

function Window:_toLocal(abs)
	return (abs - self.root.AbsolutePosition) / self:_s()
end

function Window:SetAccent(color)
	if typeof(color) ~= "Color3" then
		return
	end
	self.Accent = color
	local alive = {}
	for i = 1, #self._accentProps do
		local p = self._accentProps[i]
		if p[1].Parent then
			p[1][p[2]] = color
			alive[#alive + 1] = p
		end
	end
	self._accentProps = alive
	for i = 1, #self._accentHooks do
		pcall(self._accentHooks[i])
	end
end

function Window:_beginDrag(move, stop)
	local prev = self._drag
	if prev and prev.stop then
		pcall(prev.stop)
	end
	self._drag = { move = move, stop = stop }
end

function Window:_endDrag()
	local d = self._drag
	self._drag = nil
	if d and d.stop then
		pcall(d.stop)
	end
end

function Window:_closePopup()
	local popup = self._popup
	if not popup then
		return
	end
	local onClose = self._popupClose
	self._popup, self._popupOwner, self._popupClose = nil, nil, nil
	if onClose then
		pcall(onClose)
	end
	popup:Destroy()
end

function Window:_openPopup(frame, owner, onClose)
	self:_closePopup()
	frame.Parent = self.popups
	self._popup, self._popupOwner, self._popupClose = frame, owner, onClose
end

function Window:_popupPlacement(owner, width, height, alignRight)
	local s = self:_s()
	local lp = self:_toLocal(owner.AbsolutePosition)
	local ow = owner.AbsoluteSize.X / s
	local oh = owner.AbsoluteSize.Y / s
	local rootW, rootH = self.root.Size.X.Offset, self.root.Size.Y.Offset
	local x = alignRight and (lp.X + ow - width) or lp.X
	x = math.clamp(x, BLEED, math.max(BLEED, rootW - BLEED - width))
	local below = lp.Y + oh + 6
	if below + height <= rootH - BLEED + 6 then
		return UDim2.fromOffset(x, below), Vector2.new(0, 0)
	end
	return UDim2.fromOffset(x, lp.Y - 6), Vector2.new(0, 1)
end

function Window:_columnsFor(tab)
	local cw = self.W - (self.Layout == "Sidebar" and SIDEBAR_W or 0) - PAD * 2 - 4
	return math.clamp(math.floor((cw + GAP) / (MIN_COL + GAP)), 1, tab.Columns)
end

function Window:_placeTab(tab)
	local side = self.Layout == "Sidebar"
	local ix = side and 10 or 12
	local lx = tab.hasIcon and (ix + 24) or (ix + 2)
	tab.icon.Position = UDim2.new(0, ix, 0.5, 0)
	tab.label.Position = UDim2.fromOffset(lx, 0)
	tab.label.Size = UDim2.new(1, -(lx + 8), 1, 0)
	tab.button.Size = side and UDim2.new(1, 0, 0, TAB_H) or UDim2.new(0, tab.width, 1, 0)
	tab.button.Parent = side and self.sideList or self.topList
end

function Window:_styleTab(tab, active, instant)
	local col = active and C.Text or C.Muted
	local icol = active and self.Accent or C.Muted
	if instant then
		tab.label.TextColor3 = col
		tab.icon.ImageColor3 = icol
	else
		tween(tab.label, TI.Hover, { TextColor3 = col })
		tween(tab.icon, TI.Hover, { ImageColor3 = icol })
	end
end

function Window:_moveIndicator(instant)
	local tab = self.ActiveTab
	local side = self.Layout == "Sidebar"
	self.sideIndicator.Visible = side and tab ~= nil
	self.topIndicator.Visible = (not side) and tab ~= nil
	if not tab then
		return
	end
	local s = self:_s()
	if side then
		local y = 8 + (tab.Index - 1) * (TAB_H + TAB_GAP)
		local pos = UDim2.new(0, 8, 0, y)
		if instant then
			self.sideIndicator.Position = pos
		else
			tween(self.sideIndicator, TI.Slide, { Position = pos })
		end
		local sc = self.sideScroll
		local view = sc.AbsoluteWindowSize.Y / s
		local cy = sc.CanvasPosition.Y
		local target
		if view <= 0 then
			target = nil
		elseif y - 8 < cy then
			target = math.max(0, y - 8)
		elseif y + TAB_H + 8 > cy + view then
			target = y + TAB_H + 8 - view
		end
		if target then
			tween(sc, TI.Slide, { CanvasPosition = Vector2.new(0, target) })
		end
	else
		local x = 0
		for i = 1, tab.Index - 1 do
			x = x + self.Tabs[i].width + TAB_GAP
		end
		local props = {
			Position = UDim2.new(0, x + 12, 1, 0),
			Size = UDim2.new(0, math.max(tab.width - 24, 8), 0, 2),
		}
		if instant then
			self.topIndicator.Position = props.Position
			self.topIndicator.Size = props.Size
		else
			tween(self.topIndicator, TI.Slide, props)
		end
		local sc = self.topScroll
		local view = sc.AbsoluteWindowSize.X / s
		local cx = sc.CanvasPosition.X
		local target
		if view <= 0 then
			target = nil
		elseif x < cx then
			target = math.max(0, x - 24)
		elseif x + tab.width > cx + view then
			target = x + tab.width + 24 - view
		end
		if target then
			tween(sc, TI.Slide, { CanvasPosition = Vector2.new(target, 0) })
		end
	end
end

function Window:_updateFades()
	if self.destroyed then
		return
	end
	local s = self:_s()
	local sc = self.sideScroll
	local canvas = sc.AbsoluteCanvasSize.Y / s
	local view = sc.AbsoluteWindowSize.Y / s
	local pos = sc.CanvasPosition.Y
	self.sideFadeTop.Visible = pos > 2
	self.sideFadeBottom.Visible = pos + view < canvas - 2

	local tc = self.topScroll
	local tcanvas = tc.AbsoluteCanvasSize.X / s
	local tview = tc.AbsoluteWindowSize.X / s
	local tpos = tc.CanvasPosition.X
	self.topFadeLeft.Visible = tpos > 2
	self.topFadeRight.Visible = tpos + tview < tcanvas - 2
end

function Window:_applyLayout()
	local side = self.Layout == "Sidebar"
	local sh = self.StatusBar and STATUS_H or 0
	self.statusBar.Visible = self.StatusBar
	self.sidebar.Visible = side
	self.topbar.Visible = not side
	self.headerLine.Visible = side
	self.sidebar.Size = UDim2.new(0, SIDEBAR_W, 1, -(HEADER_H + sh))
	if side then
		self.content.Position = UDim2.fromOffset(SIDEBAR_W, HEADER_H)
		self.content.Size = UDim2.new(1, -SIDEBAR_W, 1, -(HEADER_H + sh))
	else
		self.content.Position = UDim2.fromOffset(0, HEADER_H + TOPBAR_H)
		self.content.Size = UDim2.new(1, 0, 1, -(HEADER_H + TOPBAR_H + sh))
	end
	for i = 1, #self.Tabs do
		local tab = self.Tabs[i]
		self:_placeTab(tab)
		tab:_reflow(self:_columnsFor(tab))
	end
	self:_moveIndicator(true)
	task.defer(function()
		self:_updateFades()
	end)
end

function Window:_clamp()
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local vp = cam.ViewportSize
	local hw = math.max((vp.X - self.W * self.S) / 2, 0)
	local hh = math.max((vp.Y - self.H * self.S) / 2, 0)
	local p = self.root.Position
	local x = math.clamp(p.X.Offset, -hw, hw)
	local y = math.clamp(p.Y.Offset, -hh, hh)
	if x ~= p.X.Offset or y ~= p.Y.Offset then
		self.root.Position = UDim2.new(0.5, x, 0.5, y)
	end
end

function Window:_fit(force)
	local cam = Workspace.CurrentCamera
	if not cam or self.destroyed then
		return
	end
	local vp = cam.ViewportSize
	if vp.X < 2 or vp.Y < 2 then
		return
	end
	local w, h = BASE_W, BASE_H
	local s = math.min(vp.X * 0.94 / w, vp.Y * 0.9 / h, 1)
	if s < 0.8 then
		s = 0.8
		w = math.floor(math.clamp(vp.X * 0.94 / s, MIN_W, BASE_W))
		h = math.floor(math.clamp(vp.Y * 0.9 / s, MIN_H, BASE_H))
	end
	s = math.min(s * self.UserScale, vp.X * 0.98 / w, vp.Y * 0.96 / h)
	s = math.floor(s * 1000 + 0.5) / 1000

	if force or w ~= self.W or h ~= self.H then
		self.W, self.H = w, h
		self.shell.Size = UDim2.fromOffset(w, h)
		self.root.Size = UDim2.fromOffset(w + BLEED * 2, h + BLEED * 2)
		self:_closePopup()
		self:_applyLayout()
	end
	if s ~= self.S then
		self.S = s
		self.rootScale.Scale = s
		self.notifScale.Scale = math.clamp(s, 0.8, 1)
		self:_closePopup()
	end
	self:_clamp()
end

function Window:_updateStatus()
	local key = self.MenuKey
	self.statusRight.Text = (key and key.Name or "None") .. "  to toggle"
end

function Window:SetLayout(layout)
	if layout ~= "Sidebar" and layout ~= "Topbar" then
		return
	end
	if layout == self.Layout then
		return
	end
	self.Layout = layout
	self:_closePopup()
	self:_applyLayout()
end

function Window:SetStatusBar(state)
	self.StatusBar = state and true or false
	self:_applyLayout()
end

function Window:SetTitle(title, subtitle)
	if title then
		self.titleLabel.Text = title
	end
	if subtitle then
		self.subtitleLabel.Text = subtitle
	end
end

function Window:SelectTab(tab)
	if type(tab) == "number" then
		tab = self.Tabs[tab]
	end
	if not tab or tab == self.ActiveTab then
		return
	end
	self:_closePopup()
	local prev = self.ActiveTab
	self.ActiveTab = tab
	if prev then
		prev.page.Visible = false
		self:_styleTab(prev, false)
	end
	tab.page.Visible = true
	self:_styleTab(tab, true, prev == nil)
	if prev then
		tab.holder.Position = UDim2.fromOffset(0, 10)
		tween(tab.holder, TI.Slide, { Position = UDim2.fromOffset(0, 0) })
	end
	self:_moveIndicator(prev == nil)
end

function Window:Toggle(state)
	if self.destroyed then
		return
	end
	if state == nil then
		state = not self.Open
	end
	state = state and true or false
	if state == self.Open then
		return
	end
	self.Open = state
	self:_closePopup()
	self:_endDrag()
	self._token = self._token + 1
	local token = self._token

	self.shell.Parent = self.fader
	self.fader.Visible = true
	self.root.Visible = true

	if state then
		tween(self.fader, TI.Open, { GroupTransparency = 0 })
		tween(self.pop, TI.Open, { Scale = 1 }).Completed:Once(function()
			if token ~= self._token or self.destroyed then
				return
			end
			self.shell.Parent = self.static
			self.fader.Visible = false
		end)
	else
		tween(self.pop, TI.Close, { Scale = 0.96 })
		tween(self.fader, TI.Close, { GroupTransparency = 1 }).Completed:Once(function()
			if token ~= self._token or self.destroyed then
				return
			end
			self.root.Visible = false
		end)
	end
end

function Window:Notify(opts)
	if type(opts) == "string" then
		opts = { Title = opts }
	end
	opts = opts or {}
	if self.destroyed or (self.NotificationsEnabled == false and not opts.Force) then
		return
	end

	local life = opts.Duration or 4
	local width = 280
	local inner = width - 28
	local body = opts.Text or opts.Content
	local th = 0
	if body and body ~= "" then
		th = textHeight(body, 12, inner)
	end
	local height = 12 + 16 + (th > 0 and (4 + th) or 0) + 12 + 2 + 10

	self._notifOrder = self._notifOrder + 1
	local slot = create("Frame", {
		Parent = self.notifs,
		Size = UDim2.fromOffset(width, height),
		BackgroundTransparency = 1,
		LayoutOrder = self._notifOrder,
	})

	local card = create("TextButton", {
		Parent = slot,
		Position = UDim2.fromOffset(width + 32, 0),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.Panel,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
	})
	corner(card, 8)
	stroke(card, C.Border)

	create("Frame", {
		Parent = card,
		Position = UDim2.fromOffset(0, 10),
		Size = UDim2.new(0, 2, 1, -20),
		BackgroundColor3 = self.Accent,
		BorderSizePixel = 0,
	}, { create("UICorner", { CornerRadius = UDim.new(0, 1) }) })

	text({
		Parent = card,
		Position = UDim2.fromOffset(14, 12),
		Size = UDim2.new(1, -28, 0, 16),
		Text = opts.Title or "Notice",
	})

	if th > 0 then
		text({
			Parent = card,
			Position = UDim2.fromOffset(14, 32),
			Size = UDim2.new(1, -28, 0, th),
			Text = body,
			TextColor3 = C.Muted,
			TextSize = 12,
			TextWrapped = true,
			TextTruncate = NOTRUNC,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
	end

	local track = create("Frame", {
		Parent = card,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -10),
		Size = UDim2.new(1, -28, 0, 2),
		BackgroundColor3 = C.Track,
		BorderSizePixel = 0,
	})
	round(track)

	local fill = create("Frame", {
		Parent = track,
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = self.Accent,
		BorderSizePixel = 0,
	})
	round(fill)

	tween(card, TI.Slide, { Position = UDim2.fromOffset(0, 0) })
	tween(fill, TweenInfo.new(life, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(0, 1) })

	local entry = { dismissed = false }
	function entry.dismiss()
		if entry.dismissed then
			return
		end
		entry.dismissed = true
		for i = #self._notifList, 1, -1 do
			if self._notifList[i] == entry then
				table.remove(self._notifList, i)
			end
		end
		tween(card, TI.Close, { Position = UDim2.fromOffset(width + 32, 0) }).Completed:Once(function()
			tween(slot, TI.Snap, { Size = UDim2.fromOffset(width, 0) }).Completed:Once(function()
				slot:Destroy()
			end)
		end)
	end

	self._notifList[#self._notifList + 1] = entry
	if #self._notifList > 5 then
		self._notifList[1].dismiss()
	end

	card.Activated:Connect(entry.dismiss)
	task.delay(life, entry.dismiss)
end

function Window:_configPath(name)
	return self.ConfigFolder .. "/" .. name .. ".json"
end

function Window:ListConfigs()
	local out = {}
	if not canFiles() or typeof(listfiles) ~= "function" then
		return out
	end
	local ok, files = pcall(function()
		if typeof(isfolder) == "function" and not isfolder(self.ConfigFolder) then
			return {}
		end
		return listfiles(self.ConfigFolder)
	end)
	if not ok or type(files) ~= "table" then
		return out
	end
	for i = 1, #files do
		local name = tostring(files[i]):match("([^/\\]+)%.json$")
		if name then
			out[#out + 1] = name
		end
	end
	table.sort(out)
	return out
end

function Window:SaveConfig(name)
	if not canFiles() then
		return false, "File access is not supported"
	end
	name = string.gsub(tostring(name or ""), "[^%w%-_ ]", "")
	if name == "" then
		return false, "Enter a config name"
	end
	local data = {}
	for flag, el in pairs(self.Elements) do
		local v = el.Value
		local t = typeof(v)
		if t == "Color3" then
			data[flag] = { __c = v:ToHex() }
		elseif t == "EnumItem" then
			data[flag] = { __k = v.Name }
		elseif v == nil and el.Kind == "Keybind" then
			data[flag] = { __k = "" }
		elseif t == "number" or t == "string" or t == "boolean" or t == "table" then
			data[flag] = v
		end
	end
	local ok, err = pcall(function()
		if typeof(isfolder) == "function" and typeof(makefolder) == "function" and not isfolder(self.ConfigFolder) then
			makefolder(self.ConfigFolder)
		end
		writefile(self:_configPath(name), HttpService:JSONEncode(data))
	end)
	if not ok then
		return false, tostring(err)
	end
	return true, name
end

function Window:LoadConfig(name)
	if not canFiles() then
		return false, "File access is not supported"
	end
	local path = self:_configPath(tostring(name or ""))
	local ok, data = pcall(function()
		if not isfile(path) then
			error("Config not found")
		end
		return HttpService:JSONDecode(readfile(path))
	end)
	if not ok or type(data) ~= "table" then
		return false, ok and "Config is corrupted" or tostring(data)
	end
	for flag, v in pairs(data) do
		local el = self.Elements[flag]
		if el then
			local value = v
			if type(v) == "table" and v.__c then
				local okc, c = pcall(Color3.fromHex, v.__c)
				value = okc and c or nil
			elseif type(v) == "table" and v.__k ~= nil then
				if v.__k == "" then
					value = nil
				else
					local okk, k = pcall(function()
						return Enum.KeyCode[v.__k]
					end)
					value = okk and k or nil
				end
			end
			if value ~= nil or el.Kind == "Keybind" then
				pcall(el.Set, el, value)
			end
		end
	end
	return true
end

function Window:Destroy()
	if self.destroyed then
		return
	end
	self:_closePopup()
	self:_endDrag()
	self.destroyed = true
	Library._listener = nil
	for i = 1, #self._conns do
		pcall(function()
			self._conns[i]:Disconnect()
		end)
	end
	table.clear(self._conns)
	self.shell.Parent = self.fader
	self.fader.Visible = true
	tween(self.pop, TI.Close, { Scale = 0.96 })
	tween(self.fader, TI.Close, { GroupTransparency = 1 })
	if self.mobileButton then
		self.mobileButton:Destroy()
	end
	task.delay(TI.Close.Time + 0.05, function()
		self.gui:Destroy()
	end)
	for i = #Library.Windows, 1, -1 do
		if Library.Windows[i] == self then
			table.remove(Library.Windows, i)
		end
	end
end

function Window:AddTab(opts)
	if type(opts) == "string" then
		opts = { Name = opts }
	end
	opts = opts or {}

	local tab = setmetatable({}, Tab)
	tab.Window = self
	tab.Name = opts.Name or ("Tab " .. (#self.Tabs + 1))
	tab.Columns = math.clamp(math.floor(opts.Columns or 2), 1, 3)
	tab.Sections = {}
	tab.columns = {}
	tab._cols = 0
	tab.Index = #self.Tabs + 1

	local btn = create("TextButton", {
		Name = tab.Name,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		LayoutOrder = tab.Index,
	})
	tab.button = btn

	tab.icon = create("ImageLabel", {
		Parent = btn,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 1,
		ImageColor3 = C.Muted,
		ScaleType = Enum.ScaleType.Fit,
	})
	tab.hasIcon = applyIcon(tab.icon, opts.Icon)

	tab.label = text({
		Parent = btn,
		Size = UDim2.new(1, -40, 1, 0),
		Text = tab.Name,
		TextColor3 = C.Muted,
	})

	tab.width = 12 + (tab.hasIcon and 24 or 2) + textWidth(tab.Name, 13) + 14

	tab.page = create("ScrollingFrame", {
		Parent = self.content,
		Name = tab.Name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = C.Border,
		ScrollBarImageTransparency = 0.2,
		VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = AUTO_Y,
	})
	padding(tab.page, PAD, PAD, PAD, PAD)

	tab.holder = create("Frame", {
		Parent = tab.page,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = AUTO_Y,
		BackgroundTransparency = 1,
	})
	hlist(tab.holder, GAP)

	self:_track(tab.page:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		if self._popup then
			self:_closePopup()
		end
	end))

	self:_track(btn.Activated:Connect(function()
		self:SelectTab(tab)
	end))

	self:_track(btn.MouseEnter:Connect(function()
		if tab ~= self.ActiveTab then
			tween(tab.label, TI.Hover, { TextColor3 = C.Text })
		end
	end))

	self:_track(btn.MouseLeave:Connect(function()
		if tab ~= self.ActiveTab then
			tween(tab.label, TI.Hover, { TextColor3 = C.Muted })
		end
	end))

	self.Tabs[tab.Index] = tab
	self:_placeTab(tab)
	tab:_reflow(self:_columnsFor(tab))

	if not self.ActiveTab then
		self:SelectTab(tab)
	else
		self:_styleTab(tab, false, true)
	end
	task.defer(function()
		self:_updateFades()
	end)

	return tab
end

function Tab:_reflow(n)
	if n == self._cols then
		return
	end
	self._cols = n
	for i = 1, math.max(n, #self.columns) do
		local col = self.columns[i]
		if i <= n then
			if not col then
				col = create("Frame", {
					Parent = self.holder,
					LayoutOrder = i,
					AutomaticSize = AUTO_Y,
					BackgroundTransparency = 1,
				})
				vlist(col, GAP)
				self.columns[i] = col
			end
			col.Size = UDim2.new(1 / n, -GAP * (n - 1) / n, 0, 0)
			col.Visible = true
		elseif col then
			col.Visible = false
		end
	end
	for k = 1, #self.Sections do
		local sec = self.Sections[k]
		sec.frame.Parent = self.columns[((sec.Column - 1) % n) + 1]
		sec.frame.LayoutOrder = k
	end
end

function Tab:Select()
	self.Window:SelectTab(self)
end

function Tab:AddSection(opts)
	if type(opts) == "string" then
		opts = { Name = opts }
	end
	opts = opts or {}

	local w = self.Window
	local k = #self.Sections + 1
	local sec = setmetatable({}, Section)
	sec.Window = w
	sec.Tab = self
	sec.Name = opts.Name or "Section"
	sec.Column = math.clamp(math.floor(opts.Column or (((k - 1) % self.Columns) + 1)), 1, self.Columns)
	sec._order = 0

	sec.frame = create("Frame", {
		Name = sec.Name,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = AUTO_Y,
		BackgroundColor3 = C.Section,
		BorderSizePixel = 0,
		LayoutOrder = k,
	})
	corner(sec.frame, 8)
	stroke(sec.frame, C.Line)
	padding(sec.frame, 10, 12, 12, 12)
	vlist(sec.frame, 8)

	local head = create("Frame", {
		Parent = sec.frame,
		LayoutOrder = 0,
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
	})
	text({
		Parent = head,
		Size = UDim2.new(1, 0, 0, 13),
		Text = string.upper(sec.Name),
		TextColor3 = C.Muted,
		TextSize = 11,
	})
	hline(head, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1) })

	self.Sections[k] = sec
	sec.frame.Parent = self.columns[((sec.Column - 1) % self._cols) + 1]
	return sec
end

function Section:_row(height)
	self._order = self._order + 1
	return create("Frame", {
		Parent = self.frame,
		LayoutOrder = self._order,
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
	})
end

local function finalize(w, obj, row, flag, kind)
	obj.Instance = row
	obj.Kind = kind
	function obj:SetVisible(state)
		row.Visible = state and true or false
	end
	if flag then
		w.Elements[flag] = obj
		Library.Flags[flag] = obj.Value
	end
	return obj
end

function Section:AddLabel(content)
	local w = self.Window
	self._order = self._order + 1
	local lbl = text({
		Parent = self.frame,
		LayoutOrder = self._order,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = AUTO_Y,
		Text = tostring(content or ""),
		TextColor3 = C.Faint,
		TextSize = 12,
		TextWrapped = true,
		TextTruncate = NOTRUNC,
	})
	local obj = { Value = lbl.Text }
	function obj:Set(value)
		obj.Value = tostring(value or "")
		lbl.Text = obj.Value
	end
	return finalize(w, obj, lbl, nil, "Label")
end

function Section:AddDivider()
	self._order = self._order + 1
	return hline(self.frame, { LayoutOrder = self._order })
end

function Section:AddButton(opts)
	opts = opts or {}
	local w = self.Window
	local style = opts.Style or (opts.Secondary and "Secondary") or "Primary"
	self._order = self._order + 1

	local fg = C.Text
	if style == "Primary" then
		fg = C.OnAccent
	elseif style == "Danger" then
		fg = C.Danger
	end

	local function baseColor()
		if style == "Primary" then
			return w.Accent
		end
		return C.Field
	end

	local function hoverColor()
		if style == "Primary" then
			return w.Accent:Lerp(Color3.new(1, 1, 1), 0.12)
		elseif style == "Danger" then
			return C.Danger:Lerp(C.Field, 0.84)
		end
		return C.FieldHover
	end

	local btn = create("TextButton", {
		Parent = self.frame,
		LayoutOrder = self._order,
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = baseColor(),
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Font = FONT,
		Text = opts.Name or "Button",
		TextColor3 = fg,
		TextSize = 13,
	})
	corner(btn, 6)

	local bs
	if style == "Danger" then
		bs = stroke(btn, C.Danger, 1, 0.55)
	elseif style ~= "Primary" then
		bs = stroke(btn, C.Line)
	end
	local sc = create("UIScale", { Parent = btn })

	local hovering = false

	if style == "Primary" then
		w:_hook(function()
			btn.BackgroundColor3 = hovering and hoverColor() or baseColor()
		end)
	end

	w:_track(btn.MouseEnter:Connect(function()
		hovering = true
		tween(btn, TI.Hover, { BackgroundColor3 = hoverColor() })
		if bs and style ~= "Danger" then
			tween(bs, TI.Hover, { Color = C.Border })
		end
	end))
	w:_track(btn.MouseLeave:Connect(function()
		hovering = false
		tween(btn, TI.Hover, { BackgroundColor3 = baseColor() })
		if bs and style ~= "Danger" then
			tween(bs, TI.Hover, { Color = C.Line })
		end
	end))
	w:_track(btn.Activated:Connect(function()
		sc.Scale = 1
		tween(sc, TI.Press, { Scale = 0.97 })
		if opts.Callback then
			task.spawn(opts.Callback)
		end
	end))

	local obj = { Value = nil }
	function obj:SetText(value)
		btn.Text = tostring(value)
	end
	return finalize(w, obj, btn, nil, "Button")
end

function Section:AddToggle(opts)
	opts = opts or {}
	local w = self.Window
	local obj = { Value = opts.Default == true }

	local row = self:_row(24)
	local hit = create("TextButton", {
		Parent = row,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
	})
	text({ Parent = hit, Size = UDim2.new(1, -48, 1, 0), Text = opts.Name or "Toggle" })

	local pill = create("Frame", {
		Parent = hit,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(34, 18),
		BackgroundColor3 = C.Off,
		BorderSizePixel = 0,
	})
	round(pill)

	local knob = create("Frame", {
		Parent = pill,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(12, 12),
		BackgroundColor3 = C.Knob,
		BorderSizePixel = 0,
	})
	round(knob)

	local function render(instant)
		local on = obj.Value
		local pillColor = on and w.Accent or C.Off
		local knobPos = on and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
		local knobColor = on and C.OnAccent or C.Knob
		if instant then
			pill.BackgroundColor3 = pillColor
			knob.Position = knobPos
			knob.BackgroundColor3 = knobColor
		else
			tween(pill, TI.Hover, { BackgroundColor3 = pillColor })
			tween(knob, TI.Snap, {
				Position = knobPos,
				BackgroundColor3 = knobColor,
				Size = UDim2.fromOffset(12, 12),
			})
		end
	end

	function obj:Set(value, silent)
		obj.Value = value and true or false
		setFlag(opts.Flag, obj.Value)
		render(false)
		if not silent and opts.Callback then
			task.spawn(opts.Callback, obj.Value)
		end
	end

	w:_track(hit.InputBegan:Connect(function(input)
		if isPress(input) then
			tween(knob, TI.Hover, { Size = UDim2.fromOffset(15, 12) })
		end
	end))
	w:_track(hit.InputEnded:Connect(function(input)
		if isPress(input) then
			tween(knob, TI.Hover, { Size = UDim2.fromOffset(12, 12) })
		end
	end))
	w:_track(hit.MouseLeave:Connect(function()
		tween(knob, TI.Hover, { Size = UDim2.fromOffset(12, 12) })
	end))
	w:_track(hit.Activated:Connect(function()
		obj:Set(not obj.Value)
	end))

	w:_hook(function()
		if obj.Value then
			pill.BackgroundColor3 = w.Accent
		end
	end)

	render(true)
	return finalize(w, obj, row, opts.Flag, "Toggle")
end

function Section:AddSlider(opts)
	opts = opts or {}
	local w = self.Window
	local minV, maxV = opts.Min or 0, opts.Max or 100
	if maxV < minV then
		minV, maxV = maxV, minV
	end
	local inc = opts.Increment
	local decimals = opts.Decimals
	if decimals == nil then
		decimals = 0
		if inc then
			local str = tostring(inc)
			local dot = string.find(str, ".", 1, true)
			if dot then
				decimals = #str - dot
			end
		end
	end
	local suffix = opts.Suffix or ""
	local obj = { Value = nil }

	local function snap(v)
		v = math.clamp(v, minV, maxV)
		if inc and inc > 0 then
			v = minV + math.floor((v - minV) / inc + 0.5) * inc
		end
		local m = 10 ^ decimals
		v = math.floor(v * m + 0.5) / m
		return math.clamp(v, minV, maxV)
	end

	local function fmt(v)
		if decimals <= 0 then
			return tostring(math.floor(v + 0.5)) .. suffix
		end
		return string.format("%." .. decimals .. "f", v) .. suffix
	end

	local row = self:_row(38)
	text({ Parent = row, Size = UDim2.new(1, -76, 0, 16), Text = opts.Name or "Slider" })
	local valueLabel = text({
		Parent = row,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromOffset(76, 16),
		TextColor3 = C.Muted,
		TextSize = 12,
		TextXAlignment = RIGHT,
	})

	local track = create("Frame", {
		Parent = row,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 1, -7),
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundColor3 = C.Track,
		BorderSizePixel = 0,
	})
	round(track)

	local fill = w:_accent(create("Frame", {
		Parent = track,
		Size = UDim2.fromScale(0, 1),
		BorderSizePixel = 0,
	}), "BackgroundColor3")
	round(fill)

	local knob = w:_accent(create("Frame", {
		Parent = track,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromOffset(12, 12),
		BorderSizePixel = 0,
		ZIndex = 2,
	}), "BackgroundColor3")
	round(knob)
	stroke(knob, C.Section, 3)
	local knobScale = create("UIScale", { Parent = knob })

	local hit = create("TextButton", {
		Parent = row,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		ZIndex = 3,
	})

	local fillTween, knobTween
	local function render(alpha, instant)
		if fillTween then
			fillTween:Cancel()
			fillTween = nil
		end
		if knobTween then
			knobTween:Cancel()
			knobTween = nil
		end
		if instant then
			fill.Size = UDim2.fromScale(alpha, 1)
			knob.Position = UDim2.fromScale(alpha, 0.5)
		else
			fillTween = tween(fill, TI.Snap, { Size = UDim2.fromScale(alpha, 1) })
			knobTween = tween(knob, TI.Snap, { Position = UDim2.fromScale(alpha, 0.5) })
		end
	end

	function obj:Set(value, silent, instant)
		value = snap(tonumber(value) or minV)
		local changed = value ~= obj.Value
		obj.Value = value
		valueLabel.Text = fmt(value)
		local range = maxV - minV
		render(range > 0 and (value - minV) / range or 0, instant)
		setFlag(opts.Flag, value)
		if changed and not silent and opts.Callback then
			task.spawn(opts.Callback, value)
		end
	end

	local function fromX(x, instant)
		local a, size = track.AbsolutePosition.X, track.AbsoluteSize.X
		if size <= 0 then
			return
		end
		obj:Set(minV + (maxV - minV) * math.clamp((x - a) / size, 0, 1), false, instant)
	end

	w:_track(hit.InputBegan:Connect(function(input)
		if not isPress(input) then
			return
		end
		local page = self.Tab.page
		page.ScrollingEnabled = false
		tween(knobScale, TI.Hover, { Scale = 1.3 })
		tween(valueLabel, TI.Hover, { TextColor3 = w.Accent })
		fromX(input.Position.X, false)
		w:_beginDrag(function(pos)
			fromX(pos.X, true)
		end, function()
			page.ScrollingEnabled = true
			tween(knobScale, TI.Hover, { Scale = 1 })
			tween(valueLabel, TI.Hover, { TextColor3 = C.Muted })
		end)
	end))

	obj:Set(opts.Default or minV, true, true)
	return finalize(w, obj, row, opts.Flag, "Slider")
end

function Section:AddDropdown(opts)
	opts = opts or {}
	local w = self.Window
	local multi = opts.Multi == true
	local options = opts.Options or {}
	local obj = {}

	if multi then
		obj.Value = {}
		if type(opts.Default) == "table" then
			for i = 1, #opts.Default do
				obj.Value[#obj.Value + 1] = opts.Default[i]
			end
		end
	else
		obj.Value = opts.Default
		if obj.Value == nil then
			obj.Value = options[1]
		end
	end

	local row = self:_row(48)
	text({ Parent = row, Size = UDim2.new(1, 0, 0, 16), Text = opts.Name or "Dropdown" })

	local box = create("TextButton", {
		Parent = row,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundColor3 = C.Field,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
	})
	corner(box, 6)
	local boxStroke = stroke(box, C.Line)

	local valueLabel = text({
		Parent = box,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -36, 1, 0),
		TextSize = 12,
	})

	local function chevron(x, rot)
		return create("Frame", {
			Parent = box,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, x, 0.5, 0),
			Size = UDim2.fromOffset(6, 2),
			Rotation = rot,
			BackgroundColor3 = C.Muted,
			BorderSizePixel = 0,
		}, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	end
	local chevL = chevron(-19, 45)
	local chevR = chevron(-15, -45)

	local function display()
		if multi then
			local parts = {}
			for i = 1, #obj.Value do
				parts[i] = tostring(obj.Value[i])
			end
			valueLabel.Text = #parts == 0 and "None" or table.concat(parts, ", ")
		else
			valueLabel.Text = obj.Value ~= nil and tostring(obj.Value) or "None"
		end
		valueLabel.TextColor3 = valueLabel.Text == "None" and C.Faint or C.Text
	end

	local function isSelected(option)
		if multi then
			return table.find(obj.Value, option) ~= nil
		end
		return obj.Value == option
	end

	local refresh

	function obj:Set(value, silent)
		if multi then
			local sel = {}
			if type(value) == "table" then
				for i = 1, #options do
					if table.find(value, options[i]) then
						sel[#sel + 1] = options[i]
					end
				end
			end
			obj.Value = sel
		else
			obj.Value = value
		end
		display()
		setFlag(opts.Flag, obj.Value)
		if refresh then
			refresh()
		end
		if not silent and opts.Callback then
			task.spawn(opts.Callback, obj.Value)
		end
	end

	function obj:SetOptions(list)
		options = list or {}
		if w._popupOwner == box then
			w:_closePopup()
		end
		if multi then
			obj:Set(obj.Value, true)
		elseif obj.Value == nil or not table.find(options, obj.Value) then
			obj:Set(options[1], true)
		end
	end

	function obj:GetOptions()
		return options
	end

	local function setOpen(state)
		tween(chevL, TI.Snap, { Rotation = state and -45 or 45 })
		tween(chevR, TI.Snap, { Rotation = state and 45 or -45 })
		tween(boxStroke, TI.Hover, { Color = state and w.Accent or C.Line })
	end

	local function openList()
		local s = w:_s()
		local itemH = 26
		local search = opts.Search == true or #options > 8
		local shown = math.clamp(#options, 1, 7)
		local top = search and 34 or 4
		local height = top + shown * itemH + 4
		local width = box.AbsoluteSize.X / s

		local pos, anchor = w:_popupPlacement(box, width, height, false)
		local panel = create("Frame", {
			AnchorPoint = anchor,
			Position = pos,
			Size = UDim2.fromOffset(width, 0),
			BackgroundColor3 = C.Field,
			BorderSizePixel = 0,
			ClipsDescendants = true,
		})
		corner(panel, 7)
		stroke(panel, w.Accent)

		local searchBox
		if search then
			local sf = create("Frame", {
				Parent = panel,
				Position = UDim2.fromOffset(4, 4),
				Size = UDim2.new(1, -8, 0, 26),
				BackgroundColor3 = C.Section,
				BorderSizePixel = 0,
			})
			corner(sf, 5)
			searchBox = create("TextBox", {
				Parent = sf,
				Position = UDim2.fromOffset(8, 0),
				Size = UDim2.new(1, -16, 1, 0),
				BackgroundTransparency = 1,
				ClearTextOnFocus = false,
				Font = FONT,
				PlaceholderText = "Search",
				PlaceholderColor3 = C.Faint,
				Text = "",
				TextColor3 = C.Text,
				TextSize = 12,
				TextXAlignment = LEFT,
			})
		end

		local scroll = create("ScrollingFrame", {
			Parent = panel,
			Position = UDim2.fromOffset(0, top),
			Size = UDim2.new(1, 0, 0, shown * itemH),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = C.Border,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = AUTO_Y,
		})
		padding(scroll, 0, 0, 4, 4)
		vlist(scroll, 0)

		local items = {}
		local function style(it)
			local sel = isSelected(it.option)
			it.btn.BackgroundColor3 = sel and w:_soft() or C.FieldHover
			it.btn.BackgroundTransparency = (sel or it.hover) and 0 or 1
			it.label.TextColor3 = (sel or it.hover) and C.Text or C.Muted
			if it.mark then
				it.mark.Visible = sel
			end
		end

		if #options == 0 then
			text({
				Parent = scroll,
				Size = UDim2.new(1, 0, 0, itemH),
				Text = "  No options",
				TextColor3 = C.Faint,
				TextSize = 12,
			})
		end

		for i = 1, #options do
			local option = options[i]
			local it = { option = option, hover = false }
			it.btn = create("TextButton", {
				Parent = scroll,
				LayoutOrder = i,
				Size = UDim2.new(1, 0, 0, itemH),
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				BorderSizePixel = 0,
				Text = "",
			})
			corner(it.btn, 5)
			it.label = text({
				Parent = it.btn,
				Position = UDim2.fromOffset(9, 0),
				Size = UDim2.new(1, -30, 1, 0),
				Text = tostring(option),
				TextSize = 12,
			})
			if multi then
				it.mark = create("Frame", {
					Parent = it.btn,
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -10, 0.5, 0),
					Size = UDim2.fromOffset(6, 6),
					BackgroundColor3 = w.Accent,
					BorderSizePixel = 0,
				})
				round(it.mark)
			end
			it.btn.MouseEnter:Connect(function()
				it.hover = true
				style(it)
			end)
			it.btn.MouseLeave:Connect(function()
				it.hover = false
				style(it)
			end)
			it.btn.Activated:Connect(function()
				if multi then
					local sel = {}
					local found = false
					for j = 1, #obj.Value do
						if obj.Value[j] == option then
							found = true
						else
							sel[#sel + 1] = obj.Value[j]
						end
					end
					if not found then
						sel[#sel + 1] = option
					end
					obj:Set(sel)
				else
					obj:Set(option)
					w:_closePopup()
				end
			end)
			style(it)
			items[i] = it
		end

		if searchBox then
			searchBox:GetPropertyChangedSignal("Text"):Connect(function()
				local q = string.lower(searchBox.Text)
				for i = 1, #items do
					local it = items[i]
					it.btn.Visible = q == "" or string.find(string.lower(tostring(it.option)), q, 1, true) ~= nil
				end
			end)
		end

		refresh = function()
			for i = 1, #items do
				style(items[i])
			end
		end

		w:_openPopup(panel, box, function()
			refresh = nil
			setOpen(false)
		end)
		setOpen(true)
		tween(panel, TI.Reveal, { Size = UDim2.fromOffset(width, height) })

		if not multi and obj.Value ~= nil then
			local idx = table.find(options, obj.Value)
			if idx and idx > shown then
				scroll.CanvasPosition = Vector2.new(0, (idx - shown) * itemH)
			end
		end
	end

	w:_track(box.Activated:Connect(function()
		if w._popupOwner == box then
			w:_closePopup()
		else
			openList()
		end
	end))

	w:_track(box.MouseEnter:Connect(function()
		if w._popupOwner ~= box then
			tween(boxStroke, TI.Hover, { Color = C.Border })
		end
	end))
	w:_track(box.MouseLeave:Connect(function()
		if w._popupOwner ~= box then
			tween(boxStroke, TI.Hover, { Color = C.Line })
		end
	end))

	display()
	return finalize(w, obj, row, opts.Flag, "Dropdown")
end

function Section:AddKeybind(opts)
	opts = opts or {}
	local w = self.Window
	local obj = { Value = opts.Default, Mode = opts.Mode or "Press", Callback = opts.Callback }
	local allowNone = opts.AllowNone ~= false

	local row = self:_row(24)
	text({ Parent = row, Size = UDim2.new(1, -96, 1, 0), Text = opts.Name or "Keybind" })

	local chip = create("TextButton", {
		Parent = row,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(56, 22),
		BackgroundColor3 = C.Field,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Font = FONT,
		Text = "None",
		TextColor3 = C.Muted,
		TextSize = 12,
	})
	corner(chip, 5)
	local chipStroke = stroke(chip, C.Line)

	local function show(label, color)
		chip.Text = label
		chip.TextColor3 = color
		tween(chip, TI.Snap, { Size = UDim2.fromOffset(math.max(textWidth(label, 12) + 20, 44), 22) })
	end

	function obj:Set(key, silent)
		if key ~= nil and typeof(key) ~= "EnumItem" then
			return
		end
		obj.Value = key
		show(key and key.Name or "None", key and C.Text or C.Muted)
		setFlag(opts.Flag, key)
		if not silent and opts.Changed then
			task.spawn(opts.Changed, key)
		end
	end

	w:_track(chip.Activated:Connect(function()
		if Library._listener then
			return
		end
		show("...", C.Text)
		tween(chipStroke, TI.Hover, { Color = w.Accent })
		Library._listener = function(input)
			tween(chipStroke, TI.Hover, { Color = C.Line })
			if input.UserInputType ~= Enum.UserInputType.Keyboard then
				obj:Set(obj.Value, true)
				return
			end
			local kc = input.KeyCode
			if kc == Enum.KeyCode.Escape or kc == Enum.KeyCode.Backspace then
				if allowNone then
					obj:Set(nil)
				else
					obj:Set(obj.Value, true)
				end
			elseif kc ~= Enum.KeyCode.Unknown then
				obj:Set(kc)
			else
				obj:Set(obj.Value, true)
			end
		end
	end))

	w._binds[#w._binds + 1] = obj
	obj:Set(obj.Value, true)
	return finalize(w, obj, row, opts.Flag, "Keybind")
end

function Section:AddTextbox(opts)
	opts = opts or {}
	local w = self.Window
	local obj = { Value = tostring(opts.Default or "") }

	local row = self:_row(48)
	text({ Parent = row, Size = UDim2.new(1, 0, 0, 16), Text = opts.Name or "Textbox" })

	local field = create("Frame", {
		Parent = row,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundColor3 = C.Field,
		BorderSizePixel = 0,
	})
	corner(field, 6)
	local fieldStroke = stroke(field, C.Line)

	local input = create("TextBox", {
		Parent = field,
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -20, 1, 0),
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		Font = FONT,
		Text = obj.Value,
		PlaceholderText = opts.Placeholder or "",
		PlaceholderColor3 = C.Faint,
		TextColor3 = C.Text,
		TextSize = 12,
		TextXAlignment = LEFT,
		TextTruncate = TRUNC,
	})

	function obj:Set(value, silent)
		obj.Value = tostring(value or "")
		input.Text = obj.Value
		setFlag(opts.Flag, obj.Value)
		if not silent and opts.Callback then
			task.spawn(opts.Callback, obj.Value, false)
		end
	end

	w:_track(input.Focused:Connect(function()
		tween(fieldStroke, TI.Hover, { Color = w.Accent })
	end))

	w:_track(input.FocusLost:Connect(function(enter)
		tween(fieldStroke, TI.Hover, { Color = C.Line })
		local value = input.Text
		if opts.Numeric and tonumber(value) == nil and value ~= "" then
			input.Text = obj.Value
			return
		end
		obj.Value = value
		setFlag(opts.Flag, value)
		if opts.Callback and (enter or not opts.EnterOnly) then
			task.spawn(opts.Callback, value, enter)
		end
	end))

	return finalize(w, obj, row, opts.Flag, "Textbox")
end

function Section:AddColorpicker(opts)
	opts = opts or {}
	local w = self.Window
	local obj = { Value = opts.Default or w.Accent }
	local h, s, v = obj.Value:ToHSV()

	local row = self:_row(24)
	text({ Parent = row, Size = UDim2.new(1, -44, 1, 0), Text = opts.Name or "Color" })

	local swatch = create("TextButton", {
		Parent = row,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromOffset(28, 18),
		BackgroundColor3 = obj.Value,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
	})
	corner(swatch, 5)
	local swatchStroke = stroke(swatch, C.Border)

	local refresh

	local function commit()
		local c = Color3.fromHSV(h, s, v)
		obj.Value = c
		swatch.BackgroundColor3 = c
		setFlag(opts.Flag, c)
		if refresh then
			refresh()
		end
		if opts.Callback then
			task.spawn(opts.Callback, c)
		end
	end

	function obj:Set(color, silent)
		if typeof(color) ~= "Color3" then
			return
		end
		local nh, ns, nv = color:ToHSV()
		if ns > 0.001 and nv > 0.001 then
			h = nh
		end
		s, v = ns, nv
		obj.Value = color
		swatch.BackgroundColor3 = color
		setFlag(opts.Flag, color)
		if refresh then
			refresh()
		end
		if not silent and opts.Callback then
			task.spawn(opts.Callback, color)
		end
	end

	local function openPicker()
		local PW, PH = 212, 196
		local pos, anchor = w:_popupPlacement(swatch, PW, PH, true)
		local panel = create("Frame", {
			AnchorPoint = anchor,
			Position = pos,
			Size = UDim2.fromOffset(PW, 0),
			BackgroundColor3 = C.Field,
			BorderSizePixel = 0,
			ClipsDescendants = true,
		})
		corner(panel, 8)
		stroke(panel, w.Accent)

		local body = create("Frame", {
			Parent = panel,
			Position = UDim2.fromOffset(10, 10),
			Size = UDim2.fromOffset(PW - 20, PH - 20),
			BackgroundTransparency = 1,
		})

		local square = create("Frame", {
			Parent = body,
			Size = UDim2.new(1, 0, 0, 120),
			BackgroundColor3 = Color3.fromHSV(h, 1, 1),
			BorderSizePixel = 0,
		})
		corner(square, 6)

		local white = create("Frame", {
			Parent = square,
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 2,
		})
		corner(white, 6)
		create("UIGradient", {
			Parent = white,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
		})

		local black = create("Frame", {
			Parent = square,
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0,
			ZIndex = 3,
		})
		corner(black, 6)
		create("UIGradient", {
			Parent = black,
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(1, 0),
			}),
		})

		local cursor = create("Frame", {
			Parent = square,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(s, 1 - v),
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 4,
		})
		round(cursor)
		stroke(cursor, Color3.new(1, 1, 1), 2)

		local hue = create("Frame", {
			Parent = body,
			Position = UDim2.fromOffset(0, 130),
			Size = UDim2.new(1, 0, 0, 10),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
		})
		round(hue)
		create("UIGradient", {
			Parent = hue,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0.000, Color3.fromRGB(255, 0, 0)),
				ColorSequenceKeypoint.new(0.167, Color3.fromRGB(255, 255, 0)),
				ColorSequenceKeypoint.new(0.333, Color3.fromRGB(0, 255, 0)),
				ColorSequenceKeypoint.new(0.500, Color3.fromRGB(0, 255, 255)),
				ColorSequenceKeypoint.new(0.667, Color3.fromRGB(0, 0, 255)),
				ColorSequenceKeypoint.new(0.833, Color3.fromRGB(255, 0, 255)),
				ColorSequenceKeypoint.new(1.000, Color3.fromRGB(255, 0, 0)),
			}),
		})

		local hueCursor = create("Frame", {
			Parent = hue,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(h, 0.5),
			Size = UDim2.fromOffset(6, 16),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 2,
		})
		corner(hueCursor, 3)
		stroke(hueCursor, C.Field, 1)

		local preview = create("Frame", {
			Parent = body,
			Position = UDim2.fromOffset(0, 150),
			Size = UDim2.fromOffset(26, 26),
			BackgroundColor3 = obj.Value,
			BorderSizePixel = 0,
		})
		corner(preview, 5)
		stroke(preview, C.Border)

		local hexField = create("Frame", {
			Parent = body,
			Position = UDim2.fromOffset(34, 150),
			Size = UDim2.new(1, -34, 0, 26),
			BackgroundColor3 = C.Section,
			BorderSizePixel = 0,
		})
		corner(hexField, 5)
		local hexStroke = stroke(hexField, C.Line)

		local hexBox = create("TextBox", {
			Parent = hexField,
			Position = UDim2.fromOffset(9, 0),
			Size = UDim2.new(1, -18, 1, 0),
			BackgroundTransparency = 1,
			ClearTextOnFocus = false,
			Font = FONT,
			Text = "#" .. string.upper(obj.Value:ToHex()),
			TextColor3 = C.Text,
			TextSize = 12,
			TextXAlignment = LEFT,
		})

		refresh = function()
			square.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
			cursor.Position = UDim2.fromScale(s, 1 - v)
			hueCursor.Position = UDim2.fromScale(h, 0.5)
			preview.BackgroundColor3 = obj.Value
			if not hexBox:IsFocused() then
				hexBox.Text = "#" .. string.upper(obj.Value:ToHex())
			end
		end

		local function svFrom(p)
			local a, size = square.AbsolutePosition, square.AbsoluteSize
			if size.X <= 0 or size.Y <= 0 then
				return
			end
			s = math.clamp((p.X - a.X) / size.X, 0, 1)
			v = 1 - math.clamp((p.Y - a.Y) / size.Y, 0, 1)
			commit()
		end

		local function hueFrom(p)
			local a, size = hue.AbsolutePosition, hue.AbsoluteSize
			if size.X <= 0 then
				return
			end
			h = math.clamp((p.X - a.X) / size.X, 0, 0.999)
			commit()
		end

		local svHit = create("TextButton", {
			Parent = square,
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 5,
		})
		local hueHit = create("TextButton", {
			Parent = hue,
			Position = UDim2.fromOffset(0, -4),
			Size = UDim2.new(1, 0, 1, 8),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 3,
		})

		svHit.InputBegan:Connect(function(input)
			if isPress(input) then
				svFrom(input.Position)
				w:_beginDrag(svFrom)
			end
		end)
		hueHit.InputBegan:Connect(function(input)
			if isPress(input) then
				hueFrom(input.Position)
				w:_beginDrag(hueFrom)
			end
		end)

		hexBox.Focused:Connect(function()
			tween(hexStroke, TI.Hover, { Color = w.Accent })
		end)
		hexBox.FocusLost:Connect(function()
			tween(hexStroke, TI.Hover, { Color = C.Line })
			local raw = string.gsub(string.gsub(hexBox.Text, "#", ""), "%s", "")
			local ok, c = pcall(Color3.fromHex, raw)
			if ok and typeof(c) == "Color3" then
				obj:Set(c)
			elseif refresh then
				refresh()
			end
		end)

		w:_openPopup(panel, swatch, function()
			refresh = nil
			tween(swatchStroke, TI.Hover, { Color = C.Border })
		end)
		tween(swatchStroke, TI.Hover, { Color = w.Accent })
		tween(panel, TI.Reveal, { Size = UDim2.fromOffset(PW, PH) })
	end

	w:_track(swatch.Activated:Connect(function()
		if w._popupOwner == swatch then
			w:_closePopup()
		else
			openPicker()
		end
	end))

	return finalize(w, obj, row, opts.Flag, "Colorpicker")
end

function Section:AddSegment(opts)
	opts = opts or {}
	local w = self.Window
	local options = opts.Options or { "On", "Off" }
	local n = math.max(#options, 1)
	local obj = { Value = opts.Default or options[1] }

	local row = self:_row(50)
	text({ Parent = row, Size = UDim2.new(1, 0, 0, 16), Text = opts.Name or "Mode" })

	local bar = create("Frame", {
		Parent = row,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = C.Field,
		BorderSizePixel = 0,
	})
	corner(bar, 7)
	stroke(bar, C.Line)

	local inner = create("Frame", {
		Parent = bar,
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 1, -6),
		BackgroundTransparency = 1,
	})

	local pill = w:_accent(create("Frame", {
		Parent = inner,
		Size = UDim2.new(1 / n, 0, 1, 0),
		BorderSizePixel = 0,
	}), "BackgroundColor3")
	corner(pill, 5)

	local buttons = {}
	for i = 1, #options do
		local b = create("TextButton", {
			Parent = inner,
			Position = UDim2.fromScale((i - 1) / n, 0),
			Size = UDim2.new(1 / n, 0, 1, 0),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Font = FONT,
			Text = tostring(options[i]),
			TextColor3 = C.Muted,
			TextSize = 12,
			ZIndex = 2,
		})
		buttons[i] = b
		w:_track(b.Activated:Connect(function()
			obj:Set(options[i])
		end))
	end

	local function render(instant)
		local idx = table.find(options, obj.Value) or 1
		local p = UDim2.fromScale((idx - 1) / n, 0)
		if instant then
			pill.Position = p
		else
			tween(pill, TI.Slide, { Position = p })
		end
		for i = 1, #buttons do
			local col = i == idx and C.OnAccent or C.Muted
			if instant then
				buttons[i].TextColor3 = col
			else
				tween(buttons[i], TI.Hover, { TextColor3 = col })
			end
		end
	end

	function obj:Set(value, silent)
		if not table.find(options, value) then
			return
		end
		local changed = value ~= obj.Value
		obj.Value = value
		render(false)
		setFlag(opts.Flag, value)
		if changed and not silent and opts.Callback then
			task.spawn(opts.Callback, value)
		end
	end

	render(true)
	return finalize(w, obj, row, opts.Flag, "Segment")
end

function Window:AddSettingsTab(opts)
	opts = opts or {}
	local tab = self:AddTab({ Name = opts.Name or "Settings", Icon = opts.Icon or "settings", Columns = 2 })

	local ui = tab:AddSection({ Name = "Interface", Column = 1 })
	ui:AddSegment({
		Name = "Layout",
		Options = { "Sidebar", "Topbar" },
		Default = self.Layout,
		Callback = function(value)
			self:SetLayout(value)
		end,
	})
	ui:AddSlider({
		Name = "UI scale",
		Min = 0.8,
		Max = 1.2,
		Increment = 0.05,
		Default = self.UserScale,
		Callback = function(value)
			self.UserScale = value
			self:_fit()
		end,
	})
	ui:AddColorpicker({
		Name = "Accent",
		Default = self.Accent,
		Callback = function(color)
			self:SetAccent(color)
		end,
	})
	ui:AddToggle({
		Name = "Status bar",
		Default = self.StatusBar,
		Callback = function(value)
			self:SetStatusBar(value)
		end,
	})

	local behaviour = tab:AddSection({ Name = "Behaviour", Column = 2 })
	behaviour:AddKeybind({
		Name = "Menu key",
		Default = self.MenuKey,
		AllowNone = false,
		Changed = function(key)
			self.MenuKey = key
			self:_updateStatus()
		end,
	})
	behaviour:AddToggle({
		Name = "Notifications",
		Default = self.NotificationsEnabled ~= false,
		Callback = function(value)
			self.NotificationsEnabled = value
		end,
	})
	behaviour:AddButton({
		Name = "Unload",
		Style = "Danger",
		Callback = function()
			self:Destroy()
		end,
	})

	local configs = tab:AddSection({ Name = "Configs", Column = 2 })
	if not canFiles() then
		configs:AddLabel("File access is not available in this environment, configs are disabled.")
		return tab
	end

	local nameBox = configs:AddTextbox({ Name = "Config name", Placeholder = "my config" })
	local list = configs:AddDropdown({ Name = "Saved configs", Options = self:ListConfigs() })

	configs:AddButton({
		Name = "Save",
		Callback = function()
			local name = nameBox.Value ~= "" and nameBox.Value or list.Value
			local ok, result = self:SaveConfig(name)
			if ok then
				list:SetOptions(self:ListConfigs())
				list:Set(result, true)
				self:Notify({ Title = "Config saved", Text = result, Force = true })
			else
				self:Notify({ Title = "Save failed", Text = result, Force = true })
			end
		end,
	})
	configs:AddButton({
		Name = "Load",
		Style = "Secondary",
		Callback = function()
			if not list.Value then
				self:Notify({ Title = "Pick a config first", Force = true })
				return
			end
			local ok, err = self:LoadConfig(list.Value)
			self:Notify({
				Title = ok and "Config loaded" or "Load failed",
				Text = ok and list.Value or err,
				Force = true,
			})
		end,
	})
	configs:AddButton({
		Name = "Refresh list",
		Style = "Secondary",
		Callback = function()
			list:SetOptions(self:ListConfigs())
		end,
	})

	return tab
end

